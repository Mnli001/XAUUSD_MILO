# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/xau"

# NextAuth / Auth.js
# Generate a secret: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# Data Providers
# twelvedata.com - XAUUSD price data
TWELVEDATA_API_KEY="your-twelvedata-api-key"

# fred.stlouisfed.org - Economic calendar dates
FRED_API_KEY="your-fred-api-key"

# Cron secret (to protect /api/cron/* endpoints)
CRON_SECRET="your-cron-secret"

# Initial Admin User (used in npm run seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme123"

# Telegram Bot (Optional - for setup notifications)
TELEGRAM_BOT_TOKEN=""

# Public Application URL (e.g. http://localhost:3000 or https://xau.example.com)
APP_URL="http://localhost:3000"

# Built-in internal scheduler (1 to enable internal polling every 5m/1h, useful for Railway)
ENABLE_SCHEDULER="0"

# How a newly registered person reaches the admin (shown on the "waiting for access" page).
# Any text, e.g. "Telegram: @yourname · Утас: 99112233", and an optional http(s) link for the "Write to the admin" button.
ADMIN_CONTACT=""
ADMIN_CONTACT_URL=""

# Wire (wire.mn) payments for the plans: Plus 50,000₮ / Pro 150,000₮ / Max 300,000₮. Leave empty until the Wire
# project is active (KYC, a connector switched on, a settlement account): the plans still show, the buttons wait.
# WIRE_API_KEY is the project's secret key (sk_live_..., live only). For the webhook, register
# https://<site>/api/payments/wire/webhook in the Wire dashboard and paste the whsec_... secret it shows once.
WIRE_API_KEY=""
WIRE_WEBHOOK_SECRET=""
